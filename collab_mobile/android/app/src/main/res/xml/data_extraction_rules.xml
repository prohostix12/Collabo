<?xml version="1.0" encoding="utf-8"?>
<!-- Keystore-encrypted session tokens can't be decrypted on another device,
     so keep them out of cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
